# Environment & App Settings
PROJECT_NAME="Otoichi Vinyl Marketplace"
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL with asyncpg for app, psycopg for alembic/sync if needed)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/otoichi

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Spotify Web API (Client Credentials Flow)
# Register app at https://developer.spotify.com/dashboard to obtain credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Stripe Payments (Test Mode)
# Register at https://stripe.com to obtain test API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_CURRENCY=usd

# Business Rules
LOW_STOCK_THRESHOLD=5
DEFAULT_CURRENCY=USD
FLAT_SHIPPING_RATE=5.00

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
