# Environment & App Settings
PROJECT_NAME="Otoichi Vinyl Marketplace"
ENVIRONMENT=development
DEBUG=false

# Database (MongoDB Atlas or Local MongoDB)
DATABASE_URL=mongodb://localhost:27017
MONGODB_DB_NAME=otoichi

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Spotify Web API (Client Credentials Flow)
# Obtain credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Stripe Payments (Test / Live Mode)
# Obtain keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_CURRENCY=usd
ALLOW_MOCK_PAYMENTS=true

# Resend Email & Newsletter Configuration
# Obtain API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
NEWSLETTER_FROM_EMAIL=newsletter@yourdomain.com
NEWSLETTER_FROM_NAME="Otoichi (音市)"
PUBLIC_APP_URL=https://otoichi.vercel.app
CRON_SECRET=generate_a_secure_random_secret_for_scheduled_monday_crons

# Redis / Upstash Caching Acceleration
# Create a free Redis instance on https://upstash.com or https://redis.com
# Example format: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=rediss://default:your_upstash_password_here@your_endpoint.upstash.io:6379
CACHE_ENABLED=true

# Business Rules
LOW_STOCK_THRESHOLD=5
DEFAULT_CURRENCY=USD
FLAT_SHIPPING_RATE=7.50
FREE_SHIPPING_THRESHOLD=100.00

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173


